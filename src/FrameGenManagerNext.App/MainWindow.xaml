<ui:FluentWindow x:Class="FrameGenManagerNext.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="FrameGen Manager-Next"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#F6F8FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                      Height="32"
                      Title="FrameGen Manager-Next"
                      Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app.png'}" />

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" />
            <Border x:Name="Fallback"
                    Background="#F6F8FB"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="560">
                    <TextBlock Text="WebView2 初始化失败"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#181C24"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackText"
                               Margin="0,10,0,0"
                               Opacity="0.72"
                               Foreground="#566070"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
