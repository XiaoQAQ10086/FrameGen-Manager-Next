<ui:FluentWindow x:Class="FrameGenManagerNext.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
                 Title="FrameGen Manager-Next"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 FontFamily="Segoe UI Variable Display, Segoe UI"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                      Title="FrameGen Manager-Next"
                      Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app.png'}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,18,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="8,0,8,20">
                        <TextBlock Text="{Binding ProductName}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Opacity="0.55"
                                   FontSize="12"
                                   Text="{Binding Version}" />
                    </StackPanel>

                    <ListBox x:Name="NavList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Padding" Value="12,9" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Margin="0,2,0,2"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Tag="library" AutomationProperties.Name="{loc:Loc Nav.Library}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Library24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Nav.Library}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="smooth-motion" AutomationProperties.Name="{loc:Loc Nav.SmoothMotion}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Nav.SmoothMotion}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="dlss5" AutomationProperties.Name="{loc:Loc Nav.Dlss5}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Nav.Dlss5}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="logs" AutomationProperties.Name="{loc:Loc Nav.Logs}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Bug24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Nav.Logs}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings" AutomationProperties.Name="{loc:Loc Nav.Settings}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Nav.Settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="about" AutomationProperties.Name="{loc:Loc Nav.About}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc Nav.About}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="8,16,8,4">
                        <TextBlock Text="{loc:Loc Nav.Footer1}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Opacity="0.5" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{loc:Loc Nav.Footer2}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Opacity="0.35" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Column="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
