<ui:FluentWindow x:Class="FrameGenManagerNext.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="FrameGen Manager-Next"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#F6F8FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                      Height="32"
                      Title="FrameGen Manager-Next"
                      Icon="{ui:ImageIcon 'pack://application:,,,/Assets/app.png'}" />

        <Grid x:Name="BrowserHost" Grid.Row="1">
            <Grid x:Name="WebViewHost">
                <wv2:WebView2 x:Name="Browser" />
            </Grid>
        </Grid>

        <Border x:Name="Fallback"
                Grid.Row="1"
                Background="#F6F8FB"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="580"
                        Margin="40">
                <TextBlock x:Name="FallbackTitle"
                           Text="界面加载失败"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#181C24"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackText"
                           Margin="0,12,0,0"
                           FontSize="14"
                           LineHeight="22"
                           Opacity="0.78"
                           Foreground="#566070"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <ui:Button x:Name="RetryButton"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           Appearance="Primary"
                           Content="重新加载"
                           Click="OnRetryClick" />
                <TextBlock x:Name="FallbackDetail"
                           Margin="0,16,0,0"
                           FontSize="11"
                           Opacity="0.5"
                           Foreground="#566070"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
