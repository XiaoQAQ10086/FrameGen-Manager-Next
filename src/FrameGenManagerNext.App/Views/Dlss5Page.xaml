<UserControl x:Class="FrameGenManagerNext.App.Views.Dlss5Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{loc:Loc Dlss5.Title}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.75"
                           Text="{loc:Loc Dlss5.Subtitle}" />
            </StackPanel>
            <ui:Button DockPanel.Dock="Right"
                       Appearance="Secondary" Content="{loc:Loc Common.RefreshState}"
                       Command="{Binding RefreshStatesCommand}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,16,0,0" Text="{Binding StatusText}" Opacity="0.9" />

        <ui:InfoBar Margin="0,10,0,0"
                   IsOpen="{Binding HasWarnings}"
                   IsClosable="False"
                   Severity="Warning"
                   Title="{loc:Loc Common.Warning}"
                   Message="{Binding Warnings}" />

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <DataGrid ItemsSource="{Binding Games}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource RowAlternateBrush}"
                      RowHeight="46"
                      EnableRowVirtualization="True"
                      Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,7" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Common.Game}" Binding="{Binding GameName}" Width="1.4*" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Common.Api}" Binding="{Binding ApiDisplay}" Width="80" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Dlss5.File}" Binding="{Binding FileDisplay}" Width="100" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Dlss5.ReShade}" Binding="{Binding ReShadeDisplay}" Width="130" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Common.Status}" Binding="{Binding StatusDisplay}" Width="120" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTemplateColumn Header="{loc:Loc Common.Operations}" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <ui:Button Appearance="Secondary" Content="{loc:Loc Common.Install}"
                                               Margin="0,0,4,0"
                                               Padding="5,1"
                                               FontSize="14"
                                               IsEnabled="{Binding CanInstall}"
                                               Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Appearance="Transparent" Content="{loc:Loc Common.Restore}"
                                               Margin="0,0,4,0"
                                               Padding="5,1"
                                               FontSize="14"
                                               Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Appearance="Transparent" Content="{loc:Loc Common.Uninstall}"
                                               Padding="5,1"
                                               FontSize="14"
                                               IsEnabled="{Binding CanUninstall}"
                                               ToolTip="{loc:Loc Dlss5.UninstallHint}"
                                               Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.72"
                       Text="{loc:Loc Dlss5.Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
