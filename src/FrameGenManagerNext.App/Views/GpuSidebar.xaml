<UserControl x:Class="FrameGenManagerNext.App.Views.GpuSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{loc:Loc Gpu.Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource Label}"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                    <ui:Button DockPanel.Dock="Right"
                               Padding="8,4"
                               FontSize="11"
                               Appearance="Transparent"
                               Content="{loc:Loc Common.Refresh}"
                               Command="{Binding RefreshCommand}" />
                </DockPanel>

                <TextBlock Margin="0,14,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="{Binding GpuName}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource Label}"
                           Text="{loc:Loc Gpu.DriverVersion}" />
                <TextBlock Style="{StaticResource Value}"
                           Text="{Binding DriverVersion}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.FrameGeneration}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding FrameGenerationDisplay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.SmoothMotion}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding SmoothMotionDisplay}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Route}" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding RouteDisplay}" />
                </StackPanel>

                <Border Margin="0,14,0,0"
                        Padding="12,10"
                        CornerRadius="10"
                        Background="{DynamicResource InputBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Hags}" />
                        <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding HagsDisplay}" />
                        <ui:Button Margin="0,8,0,0"
                                   HorizontalAlignment="Left"
                                   Padding="8,3"
                                   FontSize="11"
                                   Appearance="Transparent"
                                   Content="{loc:Loc Settings.OpenHags}"
                                   Command="{Binding OpenHagsSettingsCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="6">
            <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                <Expander.Header>
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{loc:Loc Gpu.SpoofTitle}" />
                </Expander.Header>
                <StackPanel Margin="10,8,10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Card}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding SpoofCurrent}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.DriverNameLabel}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding SpoofDriver}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,10,0,0"
                               Opacity="0.55"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding SpoofWarningText}" />

                    <ComboBox Margin="0,10,0,0"
                              ItemsSource="{Binding SpoofPresets}"
                              SelectedItem="{Binding SelectedSpoofPreset}" />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Primary"
                                   Content="{loc:Loc Gpu.ApplySpoof}"
                                   Command="{Binding ApplySpoofCommand}" />
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Secondary"
                                   Content="{loc:Loc Gpu.RestoreDriver}"
                                   Command="{Binding RestoreDriverCommand}" />
                        <ui:Button Appearance="Transparent"
                                   Content="{loc:Loc Gpu.RestoreOriginal}"
                                   IsEnabled="{Binding HasOriginalBackup}"
                                   Command="{Binding RestoreOriginalCommand}" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding SpoofMessage}" />
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
