<UserControl x:Class="FrameGenManagerNext.App.Views.GpuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Loc Gpu.Title}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Opacity="0.6"
                               Text="{loc:Loc Gpu.Subtitle}" />
                </StackPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="{loc:Loc Common.Refresh}"
                           Command="{Binding RefreshCommand}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Margin="0,16,0,0" Text="{Binding StatusText}" Opacity="0.8" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Card}" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding GpuName}" TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.DriverVersion}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding DriverVersion}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Route}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RouteDisplay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.FrameGeneration}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding FrameGenerationDisplay}" />
                        <TextBlock Margin="0,8,0,0"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"
                                   Text="{loc:Loc Gpu.FrameGenerationHint}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.SmoothMotion}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding SmoothMotionDisplay}" />
                        <TextBlock Margin="0,8,0,0"
                                   Opacity="0.55"
                                   TextWrapping="Wrap"
                                   Text="{loc:Loc Gpu.SmoothMotionHint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Hags}" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding HagsDisplay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.SpoofTitle}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding SpoofCurrent}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Opacity="0.65"
                                   Text="{Binding SpoofStatus}" />
                    </DockPanel>

                    <TextBlock Margin="0,10,0,0"
                               Opacity="0.6"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding SpoofWarningText}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding SpoofPresets}"
                                  SelectedItem="{Binding SelectedSpoofPreset}" />
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Content="{loc:Loc Gpu.ApplySpoof}"
                                   Command="{Binding ApplySpoofCommand}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0"
                               Opacity="0.55"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{loc:Loc Gpu.DriverNameLabel}" />
                        <Run Text="{Binding SpoofDriver, Mode=OneWay}" />
                        <Run Text="{loc:Loc Gpu.AdminLabel}" />
                        <Run Text="{Binding ElevationDisplay, Mode=OneWay}" />
                    </TextBlock>

                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Margin="0,0,8,0"
                                   Content="{loc:Loc Gpu.RestoreDriver}"
                                   Command="{Binding RestoreDriverCommand}" />
                        <ui:Button Content="{loc:Loc Gpu.RestoreOriginal}"
                                   IsEnabled="{Binding HasOriginalBackup}"
                                   Command="{Binding RestoreOriginalCommand}" />
                    </WrapPanel>

                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SpoofMessage}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Gpu.Diagnostic}" />
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding Diagnostic}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
