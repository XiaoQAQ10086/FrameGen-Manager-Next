<UserControl x:Class="FrameGenManagerNext.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{loc:Loc Library.Title}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.6"
                           Text="{loc:Loc Library.Subtitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{loc:Loc Library.Scan}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{loc:Loc Library.Add}" Command="{Binding AddGameCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}" Opacity="0.8" />
            <ProgressBar Height="4"
                         Margin="0,8,0,0"
                         Maximum="100"
                         Value="{Binding ProgressValue}" />
        </StackPanel>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.Proxy}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="116" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.ProxySlots}"
                          SelectedItem="{Binding Options.ProxySlot, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.Optimized}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="64" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.OptimizedLevels}"
                          SelectedItem="{Binding Options.Optimized, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.Frames}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="64" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.FrameMultipliers}"
                          SelectedItem="{Binding Options.Frames, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.Preset}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="64" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.Presets}"
                          SelectedItem="{Binding Options.Preset, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.Engine}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="76" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.Engines}"
                          SelectedItem="{Binding Options.Engine, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.SuperResolution}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="96" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.SuperResolutionModes}"
                          SelectedItem="{Binding Options.SuperResolutionMode, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc Library.XeSsFlow}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="86" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.XeSsFlowResolutions}"
                          SelectedItem="{Binding Options.XeSsFlow, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Loc Library.XeSsHudless}" FontSize="11" Opacity="0.55" />
                <ComboBox Width="72" Height="28" Margin="0,4,0,0"
                          ItemsSource="{Binding Options.XeSsHudlessValues}"
                          SelectedItem="{Binding Options.XeSsHudless, Mode=TwoWay}" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="#F0B429"
                   Text="{Binding Warnings}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <DataGrid ItemsSource="{Binding Games}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="#E8E8E8"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#1A1A1A"
                      RowHeight="56"
                      EnableRowVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252525" />
                        <Setter Property="Foreground" Value="#D0D0D0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,7" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Foreground" Value="#E8E8E8" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="34"
                                        Height="46"
                                        CornerRadius="4"
                                        Background="#242424"
                                        ClipToBounds="True">
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc Library.Name}" Binding="{Binding Name}" Width="1.1*" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Library.Platform}" Binding="{Binding LauncherDisplay}" Width="66" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Common.Api}" Binding="{Binding ApiDisplay}" Width="52" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Library.DeploymentState}" Binding="{Binding DeploymentStateDisplay}" Width="112" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Library.TargetDirectory}" Binding="{Binding TargetDirectory}" Width="1.35*" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="{loc:Loc Library.RenderExe}" Binding="{Binding RenderExeDisplay}" Width="1.35*" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTemplateColumn Header="{loc:Loc Common.Operations}" Width="232">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button Content="{loc:Loc Common.Deploy}"
                                               Margin="0,0,4,0"
                                               Padding="4,1"
                                               FontSize="11"
                                               Command="{Binding DataContext.DeployGameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="{loc:Loc Common.Restore}"
                                               Margin="0,0,4,0"
                                               Padding="4,1"
                                               FontSize="11"
                                               Command="{Binding DataContext.RestoreGameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="{loc:Loc Common.Open}"
                                               Margin="0,0,4,0"
                                               Padding="4,1"
                                               FontSize="11"
                                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="{loc:Loc Common.Remove}"
                                               Padding="4,1"
                                               FontSize="11"
                                               Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               CommandParameter="{Binding}" />
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.55"
                       Text="{loc:Loc Library.Empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
