<UserControl x:Class="FrameGenManagerNext.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
             xmlns:views="clr-namespace:FrameGenManagerNext.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1180">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeploymentStateValue}" Value="Installed">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeploymentStateValue}" Value="Partial">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeploymentStateValue}" Value="Conflict">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{loc:Loc Library.Title}"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Opacity="0.72"
                           FontSize="14"
                           Text="{loc:Loc Library.Subtitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ui:Button Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="{loc:Loc Library.Add}"
                           Command="{Binding AddGameCommand}" />
                <ui:Button Margin="0,0,8,0"
                           Appearance="Transparent"
                           Content="{loc:Loc Common.Cancel}"
                           Command="{Binding CancelCommand}"
                           IsEnabled="{Binding IsBusy}" />
                <ui:Button Appearance="Primary"
                           Content="{loc:Loc Library.Scan}"
                           Command="{Binding ScanCommand}" />
            </StackPanel>
        </DockPanel>

        <ui:InfoBar Grid.Row="1"
                    Margin="0,12,0,0"
                    IsOpen="{Binding HasWarnings}"
                    IsClosable="False"
                    Severity="Warning"
                    Title="{loc:Loc Common.Warning}"
                    Message="{Binding Warnings}" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <views:GpuSidebar x:Name="GpuPanel" />
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="14"
                               Opacity="0.9" />
                    <ProgressBar Height="3"
                                 Margin="0,8,0,0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <ListBox ItemsSource="{Binding Games}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" CornerRadius="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="44" Height="58" VerticalAlignment="Center">
                                            <Border CornerRadius="8"
                                                    Background="{DynamicResource NavHoverBrush}"
                                                    ClipToBounds="True" />
                                            <Image Source="{Binding CoverPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding CoverInitial}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Text="{Binding TargetDirectory}"
                                                               FontSize="12.5"
                                                               Opacity="0.72"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TargetDirectory}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <ui:Button Appearance="Secondary"
                                                               MinWidth="60"
                                                               Height="30"
                                                               Margin="0,0,6,0"
                                                               Padding="8,2"
                                                               FontSize="12.5"
                                                               Content="{loc:Loc Common.Deploy}"
                                                               Command="{Binding DataContext.OpenDeployDialogCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Appearance="Transparent"
                                                               MinWidth="60"
                                                               Height="30"
                                                               Margin="0,0,6,0"
                                                               Padding="8,2"
                                                               FontSize="12.5"
                                                               Content="{loc:Loc Common.Restore}"
                                                               Command="{Binding DataContext.RestoreGameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Appearance="Transparent"
                                                               MinWidth="50"
                                                               Height="30"
                                                               Margin="0,0,6,0"
                                                               Padding="8,2"
                                                               FontSize="12.5"
                                                               Content="{loc:Loc Common.Open}"
                                                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Appearance="Transparent"
                                                               MinWidth="60"
                                                               Height="30"
                                                               Padding="8,2"
                                                               FontSize="12.5"
                                                               Content="{loc:Loc Common.Remove}"
                                                               Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,7,0,0" Orientation="Horizontal">
                                                <Border Style="{StaticResource Chip}">
                                                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding LauncherDisplay}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}">
                                                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding ApiDisplay}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}">
                                                    <TextBlock Style="{StaticResource StatusText}" Text="{Binding DeploymentStateDisplay}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.72"
                                   Text="{loc:Loc Library.Empty}" />
                        <ui:Button Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Appearance="Primary"
                                   Content="{loc:Loc Library.Scan}"
                                   Command="{Binding ScanCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="DeployOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="20"
              Background="#A6000000"
              Visibility="{Binding IsDeployDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border x:Name="DeployCard"
                    Width="660"
                    MaxHeight="700"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DeployCardScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34"
                                      ShadowDepth="10"
                                      Opacity="0.75"
                                      Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock FontSize="23"
                                       FontWeight="SemiBold"
                                       Text="{Binding DeployTargetName}" />
                            <TextBlock Margin="0,4,0,0"
                                       Opacity="0.72"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding DeployTargetDirectory}" />
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Appearance="Transparent"
                                   FontSize="16"
                                   Content="✕"
                                   Command="{Binding CloseDeployDialogCommand}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Opacity="0.75"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc Deploy.DialogHint}" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.Proxy}" />
                                    <ComboBox ItemsSource="{Binding Options.ProxySlots}"
                                              SelectedItem="{Binding Options.ProxySlot}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.Optimized}" />
                                    <ComboBox ItemsSource="{Binding Options.OptimizedLevels}"
                                              SelectedItem="{Binding Options.Optimized}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.Frames}" />
                                    <ComboBox ItemsSource="{Binding Options.FrameMultipliers}"
                                              SelectedItem="{Binding Options.Frames}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.Preset}" />
                                    <ComboBox ItemsSource="{Binding Options.Presets}"
                                              SelectedItem="{Binding Options.Preset}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.Engine}" />
                                    <ComboBox ItemsSource="{Binding Options.Engines}"
                                              SelectedItem="{Binding Options.Engine}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.SuperResolution}" />
                                    <ComboBox ItemsSource="{Binding Options.SuperResolutionModes}"
                                              SelectedItem="{Binding Options.SuperResolutionMode}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0"
                                            Visibility="{Binding Options.IsXeSsEngine, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.XeSsFlow}" />
                                    <ComboBox ItemsSource="{Binding Options.XeSsFlowResolutions}"
                                              SelectedItem="{Binding Options.XeSsFlow}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,14,0,0"
                                            Visibility="{Binding Options.IsXeSsEngine, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Library.XeSsHudless}" />
                                    <ComboBox ItemsSource="{Binding Options.XeSsHudlessValues}"
                                              SelectedItem="{Binding Options.XeSsHudless}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Opacity="0.78"
                                   FontSize="14"
                                   Text="{loc:Loc Deploy.CloseGameHint}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Transparent"
                                       Content="{loc:Loc Common.Cancel}"
                                       Command="{Binding CloseDeployDialogCommand}" />
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Secondary"
                                       Content="{loc:Loc Common.Restore}"
                                       Command="{Binding RestoreGameCommand}"
                                       CommandParameter="{Binding DeployTarget}" />
                            <ui:Button Appearance="Primary"
                                       Content="{loc:Loc Common.Deploy}"
                                       Command="{Binding ConfirmDeployCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
