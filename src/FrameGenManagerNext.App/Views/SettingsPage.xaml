<UserControl x:Class="FrameGenManagerNext.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="#1D1D1D" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Opacity="0.6"
                               Text="界面、扫描行为和数据目录。设置立即保存到本地。" />
                </StackPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="保存设置"
                           Command="{Binding SaveCommand}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Margin="0,16,0,0" Text="{Binding StatusText}" Opacity="0.8" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="界面主题" />
                    <ComboBox Margin="0,6,0,0"
                              Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ThemeChoices}"
                              SelectedItem="{Binding SelectedTheme}" />
                    <TextBlock Margin="0,6,0,0"
                               Opacity="0.55"
                               FontSize="12"
                               Text="深色主题为当前默认配色；切换后立即生效。" />

                    <CheckBox Margin="0,16,0,0"
                              IsChecked="{Binding ShowCovers}"
                              Content="在游戏库显示 Steam 本地封面（600x900）" />
                    <CheckBox Margin="0,10,0,0"
                              IsChecked="{Binding AutoScanOnStartup}"
                              Content="启动时若游戏库为空，自动扫描游戏" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource Label}" Text="数据目录" />
                        <TextBlock DockPanel.Dock="Right"
                                   Opacity="0.55"
                                   FontSize="12"
                                   Text="{Binding ModeDisplay}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding DataRoot}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="资产包 / ReShade 安装器" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding PacksDirectory}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Content="打开"
                                   Command="{Binding OpenPacksCommand}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="部署备份" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding BackupsDirectory}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Content="打开"
                                   Command="{Binding OpenBackupsCommand}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="配置与日志" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ConfigDirectory}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LogsDirectory}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Margin="8,0,0,0"
                                       Content="配置"
                                       Command="{Binding OpenConfigCommand}" />
                            <ui:Button Margin="8,0,0,0"
                                       Content="日志"
                                       Command="{Binding OpenLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="系统设置快捷入口" />
                    <TextBlock Margin="0,6,0,0"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="硬件加速 GPU 计划（HAGS）需要重启生效；本程序只打开系统页面，不直接修改。" />
                    <ui:Button Margin="0,12,0,0"
                               HorizontalAlignment="Left"
                               Content="打开 HAGS 设置"
                               Command="{Binding OpenHagsSettingsCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
