<UserControl x:Class="FrameGenManagerNext.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FrameGenManagerNext.App.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Loc Settings.Title}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Opacity="0.6"
                               Text="{loc:Loc Settings.Subtitle}" />
                </StackPanel>
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Primary" Content="{loc:Loc Settings.Save}"
                           Command="{Binding SaveCommand}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Margin="0,16,0,0" Text="{Binding StatusText}" Opacity="0.8" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Settings.Language}" />
                    <ComboBox Margin="0,6,0,0"
                              Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding LanguageChoices}"
                              SelectedItem="{Binding SelectedLanguage}" />
                    <TextBlock Margin="0,6,0,0"
                               Opacity="0.55"
                               FontSize="12"
                               Text="{loc:Loc Settings.LanguageHint}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Label}" Text="{loc:Loc Settings.Theme}" />
                    <ComboBox Margin="0,6,0,0"
                              Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ThemeChoices}"
                              SelectedItem="{Binding SelectedTheme}" />
                    <TextBlock Margin="0,6,0,0"
                               Opacity="0.55"
                               FontSize="12"
                               Text="{loc:Loc Settings.ThemeHint}" />

                    <CheckBox Margin="0,16,0,0"
                              IsChecked="{Binding ShowCovers}"
                              Content="{loc:Loc Settings.ShowCovers}" />
                    <CheckBox Margin="0,10,0,0"
                              IsChecked="{Binding AutoScanOnStartup}"
                              Content="{loc:Loc Settings.AutoScan}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Settings.DataDirectory}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Opacity="0.55"
                                   FontSize="12"
                                   Text="{Binding ModeDisplay}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Value}" Text="{Binding DataRoot}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Settings.Assets}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding PacksDirectory}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Appearance="Secondary" Content="{loc:Loc Common.Open}"
                                   Command="{Binding OpenPacksCommand}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Settings.Backups}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding BackupsDirectory}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Appearance="Secondary" Content="{loc:Loc Common.Open}"
                                   Command="{Binding OpenBackupsCommand}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Settings.ConfigLogs}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ConfigDirectory}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LogsDirectory}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Margin="8,0,0,0"
                                       Appearance="Transparent" Content="{loc:Loc Settings.Config}"
                                       Command="{Binding OpenConfigCommand}" />
                            <ui:Button Margin="8,0,0,0"
                                       Appearance="Transparent" Content="{loc:Loc Settings.Logs}"
                                       Command="{Binding OpenLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Loc Settings.SystemShortcuts}" />
                    <TextBlock Margin="0,6,0,0"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Settings.HagsHint}" />
                    <ui:Button Margin="0,12,0,0"
                               HorizontalAlignment="Left"
                               Appearance="Secondary" Content="{loc:Loc Settings.OpenHags}"
                               Command="{Binding OpenHagsSettingsCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
