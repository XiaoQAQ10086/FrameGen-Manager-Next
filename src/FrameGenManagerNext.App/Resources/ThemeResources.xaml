<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#151922" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1F2B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3142" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A8B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4EA1FF" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#2A4A6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningBrush}" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#202636" />
    <SolidColorBrush x:Key="RowAlternateBrush" Color="#171C26" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#202634" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#202633" />
</ResourceDictionary>
