root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,props,targets,csproj,slnx,md}]
indent_size = 2

[*.cs]
indent_size = 4

# Namespace and using rules
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning

# Naming
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

# Analyzer policy
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA2007.severity = none

[src/FrameGenNext.App/**/*.cs]
# WPF and MVVM-generated code frequently triggers these; UI layer is still covered by tests.
dotnet_diagnostic.CA1416.severity = none

[**/obj/**/*.cs]
generated_code = true

[**/bin/**/*.cs]
generated_code = true
